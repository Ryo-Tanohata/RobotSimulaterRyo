"votes": [{"id": "L1", "against": "特になし", "agree": true, "reason": "行く先を伝えれば、同じ場所を重ねて探さずに済む。"}, {"id": "L3", "against": "特になし", "agree": true, "reason": "二人以上なら、ザガが来ても助け合える。"}, {"id": "L6", "against": "特になし", "agree": true, "reason": "二人組ごとに場所を分ければ、食べ物が見つかりやすい。"}, {"id": "L10", "against": "特になし", "agree": true, "reason": "見つけた物を話せば、冬に行く場所を選ぶのに役立つ。"}, {"id": "L16", "against": "特になし", "agree": true, "reason": "疲れた人は休むのがよい。"}, {"id": "L25", "against": "特になし", "agree": true, "reason": "蓄えは、その日に必要な分だけ取る。"}, {"id": "L28", "against": "特になし", "agree": true, "reason": "行く前に、どこに食べ物があるか話し合えばよい。"}, {"id": "L95", "against": "特になし", "agree": true, "reason": "けがの人は、治るまで休む。"}, {"id": "L103", "against": "特になし", "agree": true, "reason": "蓄えの毎日の確認は、一つにまとめた方が守りやすい。"}, {"id": "L105", "against": "特になし", "agree": true, "reason": "よそから来た人は、最初のうちは組で動く。"}, {"id": "L106", "against": "特になし", "agree": true, "reason": "冬の前に木の実を取って蓄えるのが、一番役に立つ。"}, {"id": "L107", "against": "特になし", "agree": true, "reason": "秋のうちに木の実を埋めれば、木が育って夏と秋に実がなる。"}, {"id": "L109", "against": "特になし", "agree": true, "reason": "まく量を刈り入れの後に決めるのは、取りすぎを防げる。"}, {"id": "L110", "against": "特になし", "agree": true, "reason": "夕方に戻る時刻を決めれば、探しに行く手間が減る。"}, {"id": "L111", "against": "特になし", "agree": true, "reason": "ヤギを囲むには二人以上が必要だ。"}, {"id": "L113", "against": "特になし", "agree": true, "reason": "冬の前に魚の場所を確かめておけば、冬の食べ物が増える。"}, {"id": "L114", "against": "特になし", "agree": true, "reason": "ヤギの世話をする人を毎晩決めるのは、いなくなるのを防ぐためにいい。"}, {"id": "L121", "against": "特になし", "agree": true, "reason": "採集や狩りは二人以上で行けば、ザガが来ても助けられる。"}, {"id": "L122", "against": "特になし", "agree": true, "reason": "夜の報告を一つにまとめれば、毎晩覚えやすい。"}, {"id": "L126", "against": "特になし", "agree": true, "reason": "夜の火と見張りは、キャンプを守るのに必要だ。"}, {"id": "L133", "against": "特になし", "agree": true, "reason": "秋のうちに土器をつくる人を決めれば、草の種を虫やネズミから守れる。"}, {"id": "L134", "against": "特になし", "agree": true, "reason": "雨の夜に入る人を順番に決めれば、外で濡れる人が減る。"}, {"id": "L137", "against": "特になし", "agree": true, "reason": "小さい子がいる家族から先に入るのは、当たり前のことだ。"}, {"id": "L139", "against": "特になし", "agree": true, "reason": "病の人を一人にしないのは大事だ。"}, {"id": "L141", "against": "特になし", "agree": true, "reason": "畑にまく量を書き残せば、どの家の分か分かる。"}, {"id": "L143", "against": "特になし", "agree": true, "reason": "採集と狩りは、近くでも林でも二人以上で行けば安全だ。"}, {"id": "L146", "against": "特になし", "agree": true, "reason": "よその畑で刈る前に分け方を決めれば、もめごとが減る。"}, {"id": "L147", "against": "特になし", "agree": true, "reason": "芋は蓄えに入れず、その夜に食べきれば腐らない。"}, {"id": "L149", "against": "特になし", "agree": true, "reason": "畑の仕事を一つにまとめれば、守りやすい。"}, {"id": "L150", "against": "特になし", "agree": true, "reason": "冬は北丘12から試すのがいい。南川12は、もう当てにしない。"}, {"id": "L153", "against": "特になし", "agree": true, "reason": "ヤギ全部の世話を毎晩決めれば、いなくなる心配が減る。"}, {"id": "L154", "against": "特になし", "agree": true, "reason": "住まいのない家を春に建てる人を決めるのに賛成だ。"}],
